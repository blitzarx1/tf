{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tfmd",
      "camelcase": "tfmd",
      "title": "t'fuck markdown",
      "scope": "source.tfmd",
      "file-types": [
        "tfmd"
      ],
      "injection-regex": "^tfmd$",
      "class-name": "TreeSitterTfmd"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tfmd grammar for tree-sitter",
    "authors": [
      {
        "name": "Dmitrii Samsonov",
        "email": "blitzar90@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/blitzarx1/tf",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}